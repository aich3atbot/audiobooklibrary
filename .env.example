# Copy to .env and fill in. All variables are read by app/config.py.

# Password for the "admin" account (required — the app refuses to start
# without it). Admin only manages user accounts; regular users are created on
# the admin's Users page, each with their own password and Hardcover token.
# The session-cookie signing secret is generated automatically and stored in
# CONFIG_DIR. Note: users' Hardcover tokens are stored in plaintext in the
# SQLite database, so protect the CONFIG_DIR volume accordingly.
ADMIN_PASSWORD=

# There is no global Hardcover token: each user account carries its own
# (bearer token from hardcover.app -> Settings -> Hardcover API; the
# "Bearer " prefix is tolerated), set on the admin's Users page.

# Torrent indexer (AudioBookBay). Its mirrors rotate domains and some serve
# expired TLS certs, so a plain http:// URL is sometimes the working one.
INDEX_URL=http://audiobookbay.fi

# Torrent client: "deluge" or "qbittorrent". DOWNLOAD_URL is the client's
# *web UI* (from a container, the host's client is host.docker.internal).
# qBittorrent needs username+password; Deluge authenticates on the password
# alone — the username is ignored, and an empty password is valid if that is
# how yours is set up.
DOWNLOAD_CLIENT=deluge
DOWNLOAD_URL=http://host.docker.internal:8112
DOWNLOAD_USERNAME=
DOWNLOAD_PASSWORD=
# Optional label to tag the app's torrents with in the client (Deluge Label
# plugin / qBittorrent category; best-effort). Empty means no label.
DOWNLOAD_LABEL=
# true: remove the torrent and its data from the client right after a
# successful import. false (default): leave it seeding per the client's own
# settings (the default IMPORT_MODE=copy hardlinks, so seeding keeps working).
DOWNLOAD_REMOVE_IMMEDIATELY=false

# Paths (defaults are the in-container mount points; override for local dev).
# DOWNLOAD_DIR must point at the directory Deluge writes *completed* downloads
# to — if Deluge saves to /downloads/complete, that is what to mount here.
CONFIG_DIR=./data/config
DOWNLOAD_DIR=./data/downloads
LIBRARY_DIR=./data/audiobooks

# How often to pull the Hardcover library
SYNC_INTERVAL_MINUTES=30
# How often to scan the download directory
WATCH_INTERVAL_SECONDS=30
# A download counts as finished when nothing in it changed for this long
DOWNLOAD_QUIET_SECONDS=120
# "copy" hardlinks/copies so seeding torrents keep their files; "move" relocates
IMPORT_MODE=copy
