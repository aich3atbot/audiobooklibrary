# Copy to .env and fill in. Most variables are read by app/config.py, which is
# also where every default lives — the commented-out lines below just record
# what that default is. Leave an optional variable out entirely (or empty) and
# the app uses its default; uncomment it only to override.
#
# The exceptions are the four paths and PUID/PGID, which docker-compose reads
# for itself and never passes to the container — see their sections below.

# Password for the "admin" account. Required on a fresh install — it creates
# the account, and the app refuses to start without either. Afterwards the
# account is stored in the database and this becomes optional:
#   left set     -> checked at every startup, and any change here replaces the
#                   stored password and signs the admin out everywhere
#   removed      -> the stored password stands (nothing else can change it, so
#                   put it back to reset a forgotten one)
# Admin only manages user accounts; regular users are created on the admin's
# Users page, each with their own password and Hardcover token.
# The session-cookie signing secret is generated automatically and stored in
# CONFIG_DIR. Note: users' Hardcover tokens are stored in plaintext in the
# SQLite database, so protect the CONFIG_DIR volume accordingly.
ADMIN_PASSWORD=

# There is no global Hardcover token: each user account carries its own
# (bearer token from hardcover.app -> Settings -> Hardcover API; the
# "Bearer " prefix is tolerated), set on the admin's Users page.

# Torrent indexer (AudioBookBay). Its mirrors rotate domains and some serve
# expired TLS certs, so a plain http:// URL is sometimes the working one.
# Optional, but searching for releases fails without it.
INDEX_URL=http://audiobookbay.fi

# Torrent client: "deluge" or "qbittorrent"; optional — downloading is
# enabled only when both DOWNLOAD_CLIENT and DOWNLOAD_URL are set. Leave
# either unset (or empty) to disable it entirely: the download UI is hidden
# and none of the DOWNLOAD_* settings below are needed. DOWNLOAD_URL is the
# client's *web UI* (from a container, the host's client is
# host.docker.internal).
# qBittorrent needs username+password; Deluge authenticates on the password
# alone — the username is ignored, and an empty password is valid if that is
# how yours is set up.
DOWNLOAD_CLIENT=qbittorrent
DOWNLOAD_URL=http://host.docker.internal:8080
DOWNLOAD_USERNAME=
DOWNLOAD_PASSWORD=
# Optional label to tag the app's torrents with in the client (Deluge Label
# plugin / qBittorrent category; best-effort). Default: no label.
#DOWNLOAD_LABEL=
# true: remove the torrent and its data from the client right after a
# successful import. Default false: leave it seeding per the client's own
# settings (the default IMPORT_MODE=copy hardlinks, so seeding keeps working).
#DOWNLOAD_REMOVE_IMMEDIATELY=false

# Paths. Required, and read by docker-compose rather than by the app: these are
# the *host* directories it bind-mounts onto the container's fixed /config,
# /downloads, /audiobooks and /imports, and compose refuses to start without
# them. Note the deliberate name collision — app/config.py has fields of the
# same names holding the *container* side, so these values reach the app only
# when you run it outside a container (`uv run uvicorn ...` reads this .env
# directly, and then they are the paths it uses). Never copy them into the
# container's `environment:`: the mount points are fixed by the image, and
# overriding a field there just points the app outside its own volume.
# DOWNLOAD_DIR must be the directory your torrent client writes *completed*
# downloads to — if it saves to /downloads/complete, that is what to mount here.
# IMPORTS_DIR is the staging area for an existing collection.
CONFIG_DIR=./data/config
DOWNLOAD_DIR=./data/downloads
LIBRARY_DIR=./data/audiobooks
IMPORTS_DIR=./data/imports

# The container runs as this user (docker-compose `user:`), so everything the
# app writes — the /config database and the organized library — is owned by
# it on the host. Optional; defaults to 1000:1000. All four mounted dirs must
# be writable by this user, and with the default IMPORT_MODE=copy the
# completed downloads must be readable by it too (hardlinks work best when
# the torrent client runs as the same user). If you previously ran the
# container as root, chown the config and library dirs once — see README.
#PUID=1000
#PGID=1000

# How often to pull the Hardcover library (default 30)
#SYNC_INTERVAL_MINUTES=30
# How often to scan the download directory (default 30)
#WATCH_INTERVAL_SECONDS=30
# A download counts as finished when nothing in it changed for this long
# (default 120)
#DOWNLOAD_QUIET_SECONDS=120
# "copy" (the default) hardlinks/copies so seeding torrents keep their files;
# "move" relocates them out of the download directory
#IMPORT_MODE=copy

# Listening in an Audiobookshelf app updates the book's read state on Hardcover.
# How long you have to listen before a book counts as "currently reading"
# (default 1). 0 marks it as soon as playback starts.
#MARK_READING_AFTER_MINUTES=1
# Audiobooks usually end in credits you never play, so a book left this close to
# the end is marked "read" as soon as you start a different book (default 30).
# 0 means only a book you listened all the way through counts as read. Never
# more than half the book, so short books still have to be listened most of the
# way through.
#MARK_READ_TAIL_MINUTES=30

# An edition that is a folder of MP3s can be converted into one chaptered .m4b
# from its book page. The target AAC bitrate (default 64k) is halved for a book
# that is mono throughout, and is never raised above the source's own bitrate —
# re-encoding 32k MP3 at 64k would spend double the space on no extra audio.
#TRANSCODE_BITRATE=64k
# Where ffmpeg is. The image builds its own 2 MB copy; override only if you
# mount a different one.
#FFMPEG_PATH=ffmpeg
