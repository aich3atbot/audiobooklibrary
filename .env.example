# Copy to .env and fill in. All variables are read by app/config.py.

# Bearer token from hardcover.app -> Settings -> Hardcover API
# (pasting the value with or without the "Bearer " prefix both work)
HARDCOVER_TOKEN=

# Prowlarr connection (from a container/sandbox, the host's Prowlarr is host.docker.internal)
PROWLARR_URL=http://host.docker.internal:9696
PROWLARR_API_KEY=
# Torznab categories searched, comma-separated (3030 = Audio/Audiobook)
PROWLARR_CATEGORIES=3030

# Paths (defaults are the in-container mount points; override for local dev)
CONFIG_DIR=./data/config
DOWNLOAD_DIR=./data/downloads
LIBRARY_DIR=./data/audiobooks

# How often to pull the Hardcover library
SYNC_INTERVAL_MINUTES=30
# How often to scan the download directory
WATCH_INTERVAL_SECONDS=30
# A download counts as finished when nothing in it changed for this long
DOWNLOAD_QUIET_SECONDS=120
# "copy" hardlinks/copies so seeding torrents keep their files; "move" relocates
IMPORT_MODE=copy
